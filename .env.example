# =========================================================================
#  COMERCIAL OPS — Variáveis de ambiente (copie para .env e preencha)
# =========================================================================

# --- Geral ---
NODE_ENV=development
APP_NAME=comercial-ops
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql://comercial:comercial@localhost:5432/comercial_ops?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Autenticação ---
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# --- ODVIX (ERP) ---
# Credenciais fornecidas pela ODVIX (Client-Id / Client-Token)
ODVIX_ENABLED=false
ODVIX_BASE_URL=http://localhost:80
ODVIX_CLIENT_ID=
ODVIX_CLIENT_TOKEN=
ODVIX_RATE_LIMIT_PER_MIN=60
ODVIX_TIMEOUT_MS=30000
# Mapa de endpoints da API ODVIX (ex: rotas comerciais). Ajuste conforme a
# instalação do cliente — a API ODVIX expõe controllers configuráveis.
ODVIX_PATH_CLIENTES=/KB_ERPnew_NThemaLocal/ApiFinanceira/APIFinan/Cliente
ODVIX_PATH_PRODUTOS=/KB_ERPnew_NThemaLocal/ApiFinanceira/APIFinan/Produto
ODVIX_PATH_PEDIDOS=/KB_ERPnew_NThemaLocal/ApiFinanceira/APIFinan/Pedido
ODVIX_PATH_VENDEDORES=/KB_ERPnew_NThemaLocal/ApiFinanceira/APIFinan/Vendedor
ODVIX_PATH_ESTOQUE=/KB_ERPnew_NThemaLocal/ApiFinanceira/APIFinan/Estoque
ODVIX_EMPRESA_ID=

# --- MERCOS (API) ---
# Company Token gerado em Mercos: Minha Conta -> Sistema -> Integração
MERCOS_ENABLED=false
MERCOS_BASE_URL=https://app.mercos.com/api
MERCOS_COMPANY_TOKEN=
MERCOS_RATE_LIMIT_PER_MIN=120
MERCOS_TIMEOUT_MS=30000

# --- Configurações de sincronização ---
SYNC_FULL_INITIAL=true
SYNC_INTERVAL_MS=600000
SYNC_PAGE_SIZE=500

# --- Segurança ---
# Quem pode criar o primeiro usuário admin no seed
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_PASSWORD=mudar123
ADMIN_NAME=Administrador

# --- Logging ---
LOG_LEVEL=debug